# ==========================================
# MarketLink frontend configuration
# ==========================================
# Only variables prefixed with VITE_ reach the browser, and they are PUBLIC once the site is built.
# Never put secrets here (JWT secret, database URI, payment keys) - those belong in server/.env only.

# Express backend (the /server folder). The app calls ${VITE_API_URL}/api/...
VITE_API_URL=http://localhost:5000
